FROM python:3.11-slim

WORKDIR /app

# Install system dependencies. `fonts-dejavu-core` ships DejaVuSans.ttf
# + DejaVuSans-Bold.ttf into /usr/share/fonts — needed because the
# default ReportLab Helvetica font has no rupee-symbol glyph (₹ renders
# as a black square box). The tax-invoice PDF registers DejaVu at
# import time and uses it for the total-row to print ₹ correctly.
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    pkg-config \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

# Copy application code
COPY . .

# Expose port
EXPOSE 8080

# Run with gunicorn for production
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "--timeout", "120", "app:app"]
